{
  "name": "ooro-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "prebuild": "pnpm exec esbuild netlify/payments.ts --bundle --platform=node --format=esm --external:mongoose --external:mongodb --outfile=netlify/functions/payments.mjs",
    "dev": "next dev",
    "build": "pnpm --filter @ooro/api build && NEXT_PRIVATE_BUILD_WORKER=1 next build",
    "start": "next start",
    "test": "pnpm --filter @ooro/api test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.16.0",
    "@prisma/client": "6.19.3",
    "framer-motion": "^12.23.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.9.4",
    "next": "15.5.24",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.5.24",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.4",
      "uuid": "^11.1.1",
      "deepmerge-ts": "^8.0.0",
      "fast-uri@3": "^3.1.6",
      "fast-uri@4": "^4.1.3"
    }
  }
}
