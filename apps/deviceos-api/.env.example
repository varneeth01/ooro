# DeviceOS API only. Keep this environment separate from the Main API.
NODE_ENV=development
DEVICEOS_API_PORT=8081
DATABASE_URL=postgresql://ooro:ooro@localhost:5432/ooro
JWT_SECRET=replace-with-a-long-secret-shared-for-cross-service-admin-auth
ACCESS_TOKEN_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:3000

# Private Cloudflare R2/S3-compatible storage; never use a public bucket.
DEVICEOS_STORAGE_MODE=s3
DEVICEOS_S3_BUCKET=ooro-deviceos-staging
DEVICEOS_S3_REGION=auto
DEVICEOS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
DEVICEOS_S3_ACCESS_KEY_ID=
DEVICEOS_S3_SECRET_ACCESS_KEY=
DEVICEOS_DOWNLOAD_BASE_URL=
DEVICEOS_MAX_APK_BYTES=134217728
DEVICEOS_AAPT2_PATH=aapt2
DEVICEOS_APKSIGNER_PATH=apksigner
DEVICEOS_REQUEST_RECEIPT_RETENTION_DAYS=7
