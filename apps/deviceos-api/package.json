{
  "name": "@ooro/deviceos-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/standalone.ts",
    "build": "prisma generate --schema ../api/prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/standalone.js",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "prisma:generate": "prisma generate --schema ../api/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.4.0",
    "jose": "^6.0.11",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
