generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String     @id @default(uuid()) @db.Uuid
  phone                       String     @unique
  email                       String?    @unique
  name                        String?
  role                        String     @default("DRIVER")
  accountStatus               String     @default("PENDING")
  passwordHash                String?
  passwordSetupTokenHash      String?    @unique
  passwordSetupTokenExpiresAt DateTime?
  passwordResetTokenHash      String?    @unique
  passwordResetTokenExpiresAt DateTime?
  passwordChangedAt           DateTime?
  failedLoginAttempts         Int        @default(0)
  lockedUntil                 DateTime?
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt
  sessions                    Session[]
  driver                      Driver?
  auditLogs                   AuditLog[]
  adminInvitationsCreated     AdminInvitation[] @relation("AdminInvitationCreator")
}

model AdminInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  name        String
  role        String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  createdById String    @db.Uuid
  createdBy   User      @relation("AdminInvitationCreator", fields: [createdById], references: [id])

  @@index([email, createdAt])
  @@index([expiresAt])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AdminLoginAttempt {
  id              String    @id @default(uuid()) @db.Uuid
  key             String    @unique
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
}

model Driver {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @unique @db.Uuid
  driverType        String                @default("INDIVIDUAL")
  onboardingStatus  String                @default("PROFILE")
  preferredLanguage String                @default("English")
  city              String?
  dateOfBirth       DateTime?
  profilePhotoUrl   String?
  emergencyContact  Json?
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents         KycDocument[]
  vehicles          Vehicle[]
  integrations      MobilityIntegration[]
  mobilityEvents    MobilityEvent[]
  rides             Ride[]
  candidates        RideCandidate[]
  earnings          EarningEntry[]
  payoutMethods     PayoutMethod[]
  payouts           Payout[]
  consents          DriverConsent[]
  incidents         SafetyIncident[]
  roadside          RoadsideRequest[]
  tickets           SupportTicket[]
  devices           DriverDevice[]
  dutySessions      DutySession[]
  permissionGrants  DriverPermissionGrant[]
  beneficiaries     BankBeneficiary[]
  activationReviews DriverActivationReview[]
  uploadSessions    DocumentUploadSession[]
  dutyLocations     DutyLocationEvent[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model FleetInquiry {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  phone        String
  email        String?
  companyName  String?
  city         String?
  fleetSize    Int?
  vehicleTypes String[]
  message      String?
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model KycDocument {
  id                   String    @id @default(uuid()) @db.Uuid
  driverId             String    @db.Uuid
  documentType         String
  storageKey           String
  maskedDocumentNumber String?
  status               String    @default("PENDING")
  submittedAt          DateTime  @default(now())
  verifiedAt           DateTime?
  verifiedBy           String?
  rejectionReason      String?
  expiresAt            DateTime?
  driver               Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, status])
}

model DriverDevice {
  id                String    @id @default(uuid()) @db.Uuid
  driverId          String    @db.Uuid
  installationId    String    @unique
  appVersion        String?
  androidVersion    String?
  manufacturer      String?
  model             String?
  notificationState String    @default("UNKNOWN")
  locationState     String    @default("UNKNOWN")
  lastSeenAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  driver            Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  dutySessions      DutySession[]

  @@index([driverId, revokedAt])
}

model DriverPermissionGrant {
  id          String    @id @default(uuid()) @db.Uuid
  driverId    String    @db.Uuid
  permission  String
  granted     Boolean   @default(false)
  source      String    @default("ANDROID")
  grantedAt   DateTime?
  revokedAt   DateTime?
  updatedAt   DateTime  @updatedAt
  driver      Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, permission])
  @@index([driverId, granted])
}

model BankBeneficiary {
  id              String    @id @default(uuid()) @db.Uuid
  driverId        String    @db.Uuid
  type            String
  maskedAccount   String
  secretRef       String
  verificationStatus String  @default("PENDING")
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  driver          Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, verificationStatus])
}

model DutySession {
  id              String        @id @default(uuid()) @db.Uuid
  driverId        String        @db.Uuid
  driverDeviceId  String?       @db.Uuid
  vehicleId       String?       @db.Uuid
  displayId       String?       @db.Uuid
  status          String        @default("ACTIVE")
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  endReason       String?
  lastLocationAt  DateTime?
  lastEventAt     DateTime?
  createdAt       DateTime      @default(now())
  driver          Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverDevice    DriverDevice? @relation(fields: [driverDeviceId], references: [id])
  locations       DutyLocationEvent[]

  @@index([driverId, status])
  @@index([driverId, startedAt])
}

model DutyLocationEvent {
  id            String      @id @default(uuid()) @db.Uuid
  driverId      String      @db.Uuid
  dutySessionId String      @db.Uuid
  occurredAt    DateTime
  latitude      Float
  longitude     Float
  accuracy      Float
  speed         Float?
  bearing       Float?
  receivedAt    DateTime    @default(now())
  driver        Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  dutySession   DutySession @relation(fields: [dutySessionId], references: [id], onDelete: Cascade)

  @@index([dutySessionId, occurredAt])
}

model DriverActivationReview {
  id          String    @id @default(uuid()) @db.Uuid
  driverId    String    @db.Uuid
  decision    String
  reason      String?
  actorId     String?   @db.Uuid
  createdAt   DateTime  @default(now())
  driver      Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
}

model DocumentUploadSession {
  id            String    @id @default(uuid()) @db.Uuid
  driverId      String    @db.Uuid
  documentType  String
  objectKey     String    @unique
  contentType   String
  sizeBytes     Int
  sha256        String
  status        String    @default("ISSUED")
  expiresAt     DateTime
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  driver        Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, status])
}

model Depot {
  id       String    @id @default(uuid()) @db.Uuid
  name     String
  city     String
  vehicles Vehicle[]
  routes   Route[]
}

model Route {
  id       String    @id @default(uuid()) @db.Uuid
  name     String
  city     String
  depotId  String?   @db.Uuid
  depot    Depot?    @relation(fields: [depotId], references: [id])
  vehicles Vehicle[]
}

model ScreenGroup {
  id      String              @id @default(uuid()) @db.Uuid
  name    String              @unique
  members ScreenGroupMember[]
}

model ScreenGroupMember {
  groupId   String      @db.Uuid
  displayId String      @db.Uuid
  group     ScreenGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  display   Display     @relation(fields: [displayId], references: [id], onDelete: Cascade)

  @@id([groupId, displayId])
  @@index([displayId])
}

model AdSchedule {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @unique @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  timezone   String   @default("Asia/Kolkata")
  priority   Int      @default(100)
  exclusive  Boolean  @default(false)
  status     String   @default("PUBLISHED")
  rules      Json
  targeting  Json
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, startsAt, endsAt])
}

model Vehicle {
  id                 String          @id @default(uuid()) @db.Uuid
  driverId           String          @db.Uuid
  type               String
  cabType            String?
  registrationNumber String          @unique
  city               String?
  area               String?
  routeId            String?         @db.Uuid
  depotId            String?         @db.Uuid
  route              Route?          @relation(fields: [routeId], references: [id])
  depot              Depot?          @relation(fields: [depotId], references: [id])
  manufacturer       String
  model              String
  year               Int?
  fuelType           String?
  status             String          @default("PENDING")
  driver             Driver          @relation(fields: [driverId], references: [id])
  displays           Display[]
  rides              Ride[]
  candidates         RideCandidate[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Display {
  id                        String                      @id @default(uuid()) @db.Uuid
  deviceId                  String                      @unique
  name                      String
  ownershipType             String?
  vehicleId                 String?                     @db.Uuid
  vehicle                   Vehicle?                    @relation(fields: [vehicleId], references: [id])
  deviceTokenHash           String?                     @unique
  state                     String                      @default("UNPAIRED")
  appVersion                String?
  manifestVersion           Int?
  lastLatitude              Float?
  lastLongitude             Float?
  lastLocationAccuracy      Float?
  lastLocationAt            DateTime?
  lastHeartbeatAt           DateTime?
  currentCampaignId         String?
  currentCreativeId         String?
  currentAssetId            String?
  currentPlaybackState      String?
  currentPlaybackStartedAt  DateTime?
  currentPlaybackPositionMs Int?
  currentExpectedDurationMs Int?
  manufacturer              String?
  model                     String?
  androidVersion            String?
  batteryLevel              Int?
  chargingState             String?
  lastNetworkType           String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  pairingCodes              DisplayPairingCode[]
  heartbeats                DisplayHeartbeat[]
  locationEvents            DisplayLocationEvent[]
  commands                  DisplayCommand[]
  campaignAssignments       DisplayCampaignAssignment[]
  candidates                RideCandidate[]
  rides                     Ride[]
  sessions                  CampaignSession[]
  playbackEvents            PlaybackEvent[]
  proofs                    ProofOfPlay[]
  trackingLinks             CampaignTrackingLink[]
  inventoryConfig           ScreenInventoryConfig?
  groups                    ScreenGroupMember[]
  tags                      String[]                    @default([])
  zoneConfig                DisplayZoneConfig?
  deviceOsDevice            ManagedDevice?

  @@index([vehicleId, state])
}

model Campaign {
  id                      String                      @id @default(uuid()) @db.Uuid
  ownerEmail              String?
  userId                  String?
  name                    String
  description             String?
  metadata                Json?
  status                  String                      @default("DRAFT")
  startsAt                DateTime?
  endsAt                  DateTime?
  timezone                String                      @default("Asia/Kolkata")
  layout                  String                      @default("FULLSCREEN_AD")
  priority                Int                         @default(0)
  campaignCenterLat       Float?
  campaignCenterLng       Float?
  radiusKm                Float?
  forecastSnapshot        Json?
  forecastGeneratedAt     DateTime?
  forecastExpiresAt       DateTime?
  forecastVersion         String?
  acceptedForecastVersion String?
  acceptedForecastAt      DateTime?
  agencyOrganizationId    String?                     @db.Uuid
  agencyClientId          String?                     @db.Uuid
  pricingPlanId           String?                     @db.Uuid
  pricingSource           String?
  effectiveRate           Int?
  pricingSnapshot         Json?
  deliveryTier            String                      @default("STANDARD")
  commercialFundingStatus String                      @default("UNFUNDED")
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  creatives               Creative[]
  schedule                AdSchedule?
  assignments             DisplayCampaignAssignment[]
  trackingLinks           CampaignTrackingLink[]

  @@index([status, startsAt, endsAt])
  @@index([agencyOrganizationId, agencyClientId, updatedAt])
}

model DisplayZoneConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  displayId           String   @unique @db.Uuid
  primaryWidthPercent Int      @default(67)
  adHeightPercent     Int      @default(86)
  qrHeightPercent     Int      @default(47)
  newsScrollSpeed     Int      @default(42)
  display             Display  @relation(fields: [displayId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model NewsAnnouncement {
  id        String    @id @default(uuid()) @db.Uuid
  text      String
  city      String?
  vehicleId String?   @db.Uuid
  priority  Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, startsAt, endsAt])
  @@index([city, vehicleId])
}

model WorkspaceBrand {
  id          String   @id @default(uuid()) @db.Uuid
  ownerEmail  String
  name        String
  website     String   @default("")
  industry    String   @default("")
  market      String   @default("")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerEmail, updatedAt])
}

model SavedAudience {
  id          String   @id @default(uuid()) @db.Uuid
  ownerEmail  String
  name        String
  description String
  locations   String   @default("")
  ageRange    String   @default("")
  interests   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerEmail, updatedAt])
}

model Creative {
  id              String                 @id @default(uuid()) @db.Uuid
  campaignId      String                 @db.Uuid
  name            String
  type            String
  status          String                 @default("PENDING_REVIEW")
  durationSeconds Int                    @default(10)
  displayOrder    Int                    @default(0)
  brandName       String?
  promotionalText String?
  qrEnabled       Boolean                @default(false)
  qrTargetUrl     String?
  qrLabel         String?
  qrVersion       Int                    @default(1)
  campaign        Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset           Asset?
  trackingLinks   CampaignTrackingLink[]

  @@index([campaignId, status])
}

model CampaignTrackingLink {
  id             String    @id @default(uuid()) @db.Uuid
  token          String    @unique
  campaignId     String    @db.Uuid
  creativeId     String    @db.Uuid
  displayId      String?   @db.Uuid
  destinationUrl String
  ctaType        String
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creative       Creative  @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  display        Display?  @relation(fields: [displayId], references: [id], onDelete: SetNull)
  scans          QrScan[]

  @@index([campaignId, creativeId, displayId])
  @@index([active, expiresAt])
}

model QrScan {
  id             String               @id @default(uuid()) @db.Uuid
  eventId        String               @unique
  trackingLinkId String               @db.Uuid
  campaignId     String               @db.Uuid
  creativeId     String               @db.Uuid
  displayId      String?              @db.Uuid
  occurredAt     DateTime             @default(now())
  trackingLink   CampaignTrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)

  @@index([campaignId, occurredAt])
  @@index([trackingLinkId, occurredAt])
}

model Asset {
  id              String   @id @default(uuid()) @db.Uuid
  creativeId      String   @unique @db.Uuid
  fileName        String
  storageKey      String
  url             String
  checksum        String?
  mimeType        String?
  sizeBytes       BigInt?
  width           Int?
  height          Int?
  durationSeconds Int?
  active          Boolean  @default(true)
  creative        Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
}

model DisplayCampaignAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  displayId  String   @db.Uuid
  campaignId String   @db.Uuid
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  display    Display  @relation(fields: [displayId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([displayId, campaignId])
  @@index([displayId, active])
}

model GuestCampaignOrder {
  id                     String    @id @default(uuid()) @db.Uuid
  publicOrderNumber      String    @unique
  customerName           String
  customerEmail          String
  customerPhone          String
  businessName           String
  gstin                  String?
  campaignNotes          String?
  websiteOrInstagram     String?
  packageId              String
  city                   String
  autos                  Int
  hoursPerDay            Int
  campaignDurationDays   Int
  subtotal               Int
  tax                    Int       @default(0)
  total                  Int
  currency               String    @default("INR")
  status                 String    @default("CREATED")
  razorpayOrderId        String?   @unique
  razorpayPaymentId      String?
  paymentCapturedAt      DateTime?
  campaignId             String?
  ownerEmail             String?
  holdId                 String?
  userId                 String?
  paymentProcessedAt     DateTime?
  failureReason          String?
  resolutionStatus       String    @default("OPEN")
  resolutionNote         String?
  resolvedAt             DateTime?
  resolvedBy             String?
  refundReference        String?
  refundAmount           Int?
  refundedAt             DateTime?
  refundedBy             String?
  receiptNumber          String?   @unique
  receiptAccessTokenHash String?   @unique
  emailDeliveryStatus    String    @default("PENDING")
  emailLastError         String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([campaignId, ownerEmail, status])
}

model SelfServePaymentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String
  campaignId String?
  eventType  String
  actor      String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([eventType, createdAt])
}

model AdBalanceAccount {
  id                 String                 @id @default(uuid()) @db.Uuid
  accountId          String                 @unique
  currency           String                 @default("INR")
  cachedBalancePaise BigInt                 @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  entries            AdBalanceLedgerEntry[]

  @@index([accountId])
}

model AdBalanceLedgerEntry {
  id                String           @id @default(uuid()) @db.Uuid
  accountId         String           @db.Uuid
  type              String
  amountPaise       BigInt
  currency          String           @default("INR")
  campaignId        String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  idempotencyKey    String           @unique
  metadata          Json?
  createdAt         DateTime         @default(now())
  account           AdBalanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([campaignId, createdAt])
}

model AdBalanceRechargeOrder {
  id                String   @id @default(uuid()) @db.Uuid
  accountId         String
  razorpayOrderId   String   @unique
  amountPaise       BigInt
  status            String   @default("CREATED")
  razorpayPaymentId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([accountId, createdAt])
}

model RazorpayWebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model DisplayPairingCode {
  id         String    @id @default(uuid()) @db.Uuid
  displayId  String    @db.Uuid
  codeHash   String    @unique
  codeLast4  String
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  display    Display   @relation(fields: [displayId], references: [id], onDelete: Cascade)

  @@index([displayId, expiresAt])
}

model DisplayHeartbeat {
  id                 String    @id @default(uuid()) @db.Uuid
  displayId          String    @db.Uuid
  occurredAt         DateTime
  receivedAt         DateTime  @default(now())
  appVersion         String?
  deviceVersion      String?
  storageFree        BigInt?
  storageTotal       BigInt?
  networkType        String?
  networkConnected   Boolean?
  manifestVersion    Int?
  currentCreativeId  String?
  playbackState      String?
  screenState        String?
  temperature        Float?
  latitude           Float?
  longitude          Float?
  accuracyMeters     Float?
  speedMps           Float?
  headingDegrees     Float?
  locationOccurredAt DateTime?
  currentCampaignId  String?
  currentAssetId     String?
  playbackStartedAt  DateTime?
  playbackPositionMs Int?
  expectedDurationMs Int?
  manufacturer       String?
  model              String?
  androidVersion     String?
  batteryLevel       Int?
  chargingState      String?
  display            Display   @relation(fields: [displayId], references: [id], onDelete: Cascade)

  @@index([displayId, occurredAt])
}

model DisplayLocationEvent {
  id             String   @id @default(uuid()) @db.Uuid
  displayId      String   @db.Uuid
  latitude       Float
  longitude      Float
  accuracyMeters Float
  speedMps       Float?
  headingDegrees Float?
  occurredAt     DateTime
  receivedAt     DateTime @default(now())
  display        Display  @relation(fields: [displayId], references: [id], onDelete: Cascade)

  @@index([displayId, occurredAt])
  @@index([occurredAt])
}

model DisplayCommand {
  id             String    @id @default(uuid()) @db.Uuid
  displayId      String    @db.Uuid
  commandType    String
  payload        Json?
  status         String    @default("QUEUED")
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?
  acknowledgedAt DateTime?
  failedAt       DateTime?
  expiresAt      DateTime?
  error          String?
  display        Display   @relation(fields: [displayId], references: [id], onDelete: Cascade)

  @@index([displayId, status])
}

model MobilityIntegration {
  id            String    @id @default(uuid()) @db.Uuid
  driverId      String    @db.Uuid
  provider      String
  enabled       Boolean   @default(false)
  lastEventAt   DateTime?
  parserVersion Int?
  status        String    @default("DISCONNECTED")
  driver        Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, provider])
}

model MobilityEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @unique
  driverId      String   @db.Uuid
  vehicleId     String?  @db.Uuid
  provider      String
  eventType     String
  occurredAt    DateTime
  receivedAt    DateTime @default(now())
  confidence    Float
  source        String?
  sourcePackage String?
  evidenceClass String     @default("UNKNOWN")
  diagnosticCode String?
  parserVersion Int?
  rawAllowed    Boolean  @default(false)
  driver        Driver   @relation(fields: [driverId], references: [id])

  @@index([driverId, occurredAt])
}

model RideCandidate {
  id                 String      @id @default(uuid()) @db.Uuid
  driverId           String      @db.Uuid
  vehicleId          String?     @db.Uuid
  displayId          String?     @db.Uuid
  provider           String
  source             String
  state              String      @default("DETECTED")
  createdAt          DateTime    @default(now())
  lastEventAt        DateTime
  verificationStatus String      @default("PENDING")
  driver             Driver      @relation(fields: [driverId], references: [id])
