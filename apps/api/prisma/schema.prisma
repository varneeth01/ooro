generator client {
provider = "prisma-client-js"
binaryTargets = ["native", "rhel-openssl-3.0.x"]
}
datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
}

model User {
id String @id @default(uuid()) @db.Uuid
phone String @unique
email String? @unique
name String?
role String @default("DRIVER")
accountStatus String @default("PENDING")
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
sessions Session[]
driver Driver?
auditLogs AuditLog[]
}
model Session {
id String @id @default(uuid()) @db.Uuid
userId String @db.Uuid
refreshTokenHash String @unique
expiresAt DateTime
revokedAt DateTime?
createdAt DateTime @default(now())
user User @relation(fields: [userId], references: [id], onDelete: Cascade)
@@index([userId, expiresAt])
}
model OtpChallenge {
id String @id @default(uuid()) @db.Uuid
phone String
codeHash String
expiresAt DateTime
consumedAt DateTime?
attempts Int @default(0)
createdAt DateTime @default(now())
@@index([phone, expiresAt])
}
model Driver {
id String @id @default(uuid()) @db.Uuid
userId String @unique @db.Uuid
driverType String @default("INDIVIDUAL")
onboardingStatus String @default("PROFILE")
preferredLanguage String @default("English")
city String?
dateOfBirth DateTime?
profilePhotoUrl String?
emergencyContact Json?
user User @relation(fields: [userId], references: [id], onDelete: Cascade)
documents KycDocument[]
vehicles Vehicle[]
integrations MobilityIntegration[]
mobilityEvents MobilityEvent[]
rides Ride[]
candidates RideCandidate[]
earnings EarningEntry[]
payoutMethods PayoutMethod[]
payouts Payout[]
consents DriverConsent[]
incidents SafetyIncident[]
roadside RoadsideRequest[]
tickets SupportTicket[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}
model FleetInquiry {
id String @id @default(uuid()) @db.Uuid
name String
phone String
email String?
companyName String?
city String?
fleetSize Int?
vehicleTypes String[]
message String?
status String @default("NEW")
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}
model KycDocument {
id String @id @default(uuid()) @db.Uuid
driverId String @db.Uuid
documentType String
storageKey String
maskedDocumentNumber String?
status String @default("PENDING")
submittedAt DateTime @default(now())
verifiedAt DateTime?
verifiedBy String?
rejectionReason String?
expiresAt DateTime?
driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
@@index([driverId, status])
}
model Vehicle {
id String @id @default(uuid()) @db.Uuid
driverId String @db.Uuid
type String
cabType String?
registrationNumber String @unique
manufacturer String
model String
year Int?
fuelType String?
status String @default("PENDING")
driver Driver @relation(fields: [driverId], references: [id])
displays Display[]
rides Ride[]
candidates RideCandidate[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}
model Display {
id String @id @default(uuid()) @db.Uuid
deviceId String @unique
name String
ownershipType String?
vehicleId String? @db.Uuid
vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
deviceTokenHash String? @unique
state String @default("UNPAIRED")
appVersion String?
manifestVersion Int?
lastLatitude Float?
lastLongitude Float?
lastLocationAccuracy Float?
lastLocationAt DateTime?
lastHeartbeatAt DateTime?
currentCampaignId String?
currentCreativeId String?
currentAssetId String?
currentPlaybackState String?
currentPlaybackStartedAt DateTime?
currentPlaybackPositionMs Int?
currentExpectedDurationMs Int?
manufacturer String?
model String?
androidVersion String?
batteryLevel Int?
chargingState String?
lastNetworkType String?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
pairingCodes DisplayPairingCode[]
heartbeats DisplayHeartbeat[]
locationEvents DisplayLocationEvent[]
commands DisplayCommand[]
campaignAssignments DisplayCampaignAssignment[]
candidates RideCandidate[]
rides Ride[]
sessions CampaignSession[]
playbackEvents PlaybackEvent[]
proofs ProofOfPlay[]
trackingLinks CampaignTrackingLink[]
inventoryConfig ScreenInventoryConfig?
@@index([vehicleId, state])
}

model Campaign {
id String @id @default(uuid()) @db.Uuid
ownerEmail String?
userId String?
name String
description String?
metadata Json?
status String @default("DRAFT")
startsAt DateTime?
endsAt DateTime?
timezone String @default("Asia/Kolkata")
layout String @default("FULLSCREEN_AD")
priority Int @default(0)
campaignCenterLat Float?
campaignCenterLng Float?
radiusKm Float?
forecastSnapshot Json?
forecastGeneratedAt DateTime?
forecastExpiresAt DateTime?
forecastVersion String?
acceptedForecastVersion String?
acceptedForecastAt DateTime?
agencyOrganizationId String? @db.Uuid
agencyClientId String? @db.Uuid
pricingPlanId String? @db.Uuid
pricingSource String?
effectiveRate Int?
pricingSnapshot Json?
  deliveryTier String @default("STANDARD")
  commercialFundingStatus String @default("UNFUNDED")
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
creatives Creative[]
assignments DisplayCampaignAssignment[]
trackingLinks CampaignTrackingLink[]
@@index([status, startsAt, endsAt])
@@index([agencyOrganizationId, agencyClientId, updatedAt])
}

model WorkspaceBrand {
id String @id @default(uuid()) @db.Uuid
ownerEmail String
name String
website String @default("")
industry String @default("")
market String @default("")
description String?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([ownerEmail, updatedAt])
}

model SavedAudience {
id String @id @default(uuid()) @db.Uuid
ownerEmail String
name String
description String
locations String @default("")
ageRange String @default("")
interests String @default("")
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([ownerEmail, updatedAt])
}

model Creative {
id String @id @default(uuid()) @db.Uuid
campaignId String @db.Uuid
name String
type String
status String @default("ACTIVE")
durationSeconds Int @default(10)
displayOrder Int @default(0)
campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
asset Asset?
trackingLinks CampaignTrackingLink[]
@@index([campaignId, status])
}

model CampaignTrackingLink {
id String @id @default(uuid()) @db.Uuid
token String @unique
campaignId String @db.Uuid
creativeId String @db.Uuid
displayId String? @db.Uuid
destinationUrl String
ctaType String
active Boolean @default(true)
createdAt DateTime @default(now())
expiresAt DateTime?
campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
creative Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
display Display? @relation(fields: [displayId], references: [id], onDelete: SetNull)
scans QrScan[]
@@index([campaignId, creativeId, displayId])
@@index([active, expiresAt])
}

model QrScan {
id String @id @default(uuid()) @db.Uuid
eventId String @unique
trackingLinkId String @db.Uuid
campaignId String @db.Uuid
creativeId String @db.Uuid
displayId String? @db.Uuid
occurredAt DateTime @default(now())
trackingLink CampaignTrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
@@index([campaignId, occurredAt])
@@index([trackingLinkId, occurredAt])
}

model Asset {
id String @id @default(uuid()) @db.Uuid
creativeId String @unique @db.Uuid
fileName String
storageKey String
url String
checksum String?
mimeType String?
sizeBytes BigInt?
width Int?
