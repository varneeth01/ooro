  coverage          Json?
  premiumEligible   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  screen            Display  @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@index([commercialSlots, premiumSlots])
}

model ForecastSetting {
  id                       String   @id @default(uuid()) @db.Uuid
  key                      String   @unique
  averageRidesPerDay       Int      @default(12)
  averagePassengersPerRide Int      @default(2)
  fallbackActiveAutoFactor Float    @default(0.6)
  minimumSelfServeBudget   Int      @default(1000)
  forecastTtlMinutes       Int      @default(15)
  inventoryHoldMinutes     Int      @default(15)
  updatedBy                String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model InventoryAllocation {
  scheduleId    String?   @db.Uuid
  id            String    @id @default(uuid()) @db.Uuid
  campaignId    String    @db.Uuid
  screenId      String    @db.Uuid
  autoId        String?
  date          DateTime
  slot          Int
  rate          Int?
  pricingSource String?
  status        String    @default("RESERVED")
  holdId        String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([screenId, date, slot])
  @@index([campaignId, date, status])
}
