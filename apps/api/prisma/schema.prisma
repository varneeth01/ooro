createdAt DateTime @default(now())
display Display @relation(fields: [displayId], references: [id], onDelete: Cascade)
campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
@@unique([displayId, campaignId])
@@index([displayId, active])
}

model GuestCampaignOrder {
id String @id @default(uuid()) @db.Uuid
publicOrderNumber String @unique
customerName String
customerEmail String
customerPhone String
businessName String
gstin String?
campaignNotes String?
websiteOrInstagram String?
packageId String
city String
autos Int
hoursPerDay Int
campaignDurationDays Int
subtotal Int
tax Int @default(0)
total Int
currency String @default("INR")
status String @default("CREATED")
razorpayOrderId String? @unique
razorpayPaymentId String?
paymentCapturedAt DateTime?
campaignId String?
ownerEmail String?
holdId String?
userId String?
paymentProcessedAt DateTime?
failureReason String?
resolutionStatus String @default("OPEN")
resolutionNote String?
resolvedAt DateTime?
resolvedBy String?
refundReference String?
refundAmount Int?
refundedAt DateTime?
refundedBy String?
receiptNumber String? @unique
receiptAccessTokenHash String? @unique
emailDeliveryStatus String @default("PENDING")
emailLastError String?
