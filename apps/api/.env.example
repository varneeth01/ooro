DATABASE_URL=postgresql://ooro:ooro@localhost:5432/ooro?schema=public
MONGODB_URI=mongodb://localhost:27017/ooro
REDIS_URL=redis://localhost:6379
API_PORT=8080
TRACKING_BASE_URL=https://theooro.com
# Public base URL for creative delivery. Use an HTTPS public object/CDN origin
# for internet devices; use a reachable HTTP LAN origin only for local debug.
PUBLIC_ASSET_BASE_URL=https://assets.example.com
# Optional production GCS bucket. The Cloud Run service uses its service account
# credentials; no key file or credential is stored in the image.
# GCS_BUCKET_NAME=ooro-production-creatives-757291597913
OBJECT_STORAGE_DIR=/var/lib/ooro/uploads
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
DEV_MOCK_OTP_ENABLED=true
DEV_MOCK_OTP=000000
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=replace-with-a-local-only-password-at-least-12-chars
NODE_ENV=development
EMAIL_FROM=OORO <hello@ooro.in>
EMAIL_PROVIDER_API_KEY=
ADMIN_WEB_BASE_URL=http://localhost:3000
ADMIN_PASSWORD_RESET_TTL_SECONDS=3600
ADMIN_PASSWORD_SETUP_TTL_SECONDS=86400
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_LOGIN_LOCK_SECONDS=900
# DeviceOS APK storage. Local mode is for development only; production must use
# an S3-compatible private bucket with short-lived signed URLs.
DEVICEOS_AAPT2_PATH=aapt2
DEVICEOS_APKSIGNER_PATH=apksigner
DEVICEOS_MAX_APK_BYTES=134217728
DEVICEOS_STORAGE_MODE=local
DEVICEOS_STORAGE_DIR=/var/lib/ooro/deviceos-releases
DEVICEOS_S3_BUCKET=
DEVICEOS_S3_REGION=auto
DEVICEOS_S3_ENDPOINT=
DEVICEOS_S3_ACCESS_KEY_ID=
DEVICEOS_S3_SECRET_ACCESS_KEY=
DEVICEOS_DOWNLOAD_BASE_URL=
DEVICEOS_REQUEST_RECEIPT_RETENTION_DAYS=7
