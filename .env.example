# Public site URL used for canonical URLs, Open Graph URLs, and sitemap output.
NEXT_PUBLIC_SITE_URL=https://ooro.in
# Browser and server-side frontend calls to the separate API service.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional waitlist persistence adapter. If empty, submissions are accepted by
# the API route and persisted in the browser for local/demo use.
WAITLIST_WEBHOOK_URL=

# Optional admin/device data mode. Keep unset in production unless intentionally
# enabling mock device data.
# NEXT_PUBLIC_DEVICE_DATA_SOURCE=mock
# Server-only token used by the admin screen proxy when connecting to apps/api.
# OORO_ADMIN_API_TOKEN=

# The separate apps/api service uses these variables when deployed independently.
# DATABASE_URL=
# MONGODB_URI=mongodb://localhost:27017/ooro
# ALLOW_LIVE_RAZORPAY_IN_DEVELOPMENT=false
# JWT_SECRET=
# API_PORT=8080
# CORS_ORIGINS=http://localhost:3000
# DEV_MOCK_OTP_ENABLED=false
