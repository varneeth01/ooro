# Public site URL used for canonical URLs, Open Graph URLs, and sitemap output.
NEXT_PUBLIC_SITE_URL=https://ooro.in
# Leave empty on Netlify: public payment routes run same-origin as Next.
# Set this only when intentionally using a separate local API service.
NEXT_PUBLIC_API_URL=

# Optional waitlist persistence adapter. If empty, submissions are accepted by
# the API route and persisted in the browser for local/demo use.
WAITLIST_WEBHOOK_URL=

# Optional admin/device data mode. Keep unset in production unless intentionally
# enabling mock device data.
# NEXT_PUBLIC_DEVICE_DATA_SOURCE=mock
# Server-only JWT used by the admin screen proxy when connecting to apps/api.
# It is sent as Authorization: Bearer <token>; never expose it to the browser.
# Optional development-only fallback; production admin requests use the logged-in session.
# OORO_ADMIN_API_TOKEN=
# ALLOW_ADMIN_TOKEN_FALLBACK=false

# Creative delivery storage. Local development writes to public/uploads; production
# must provide an object/file storage mount and a public HTTPS asset base URL.
# OBJECT_STORAGE_DIR=
# PUBLIC_ASSET_BASE_URL=https://app.example.com
# OORO_SESSION_SECRET=

# The separate apps/api service uses these variables when deployed independently.
# DATABASE_URL=
# MONGODB_URI=mongodb://localhost:27017/ooro
# Public checkout storage/provider configuration (server-only except key ID).
# MONGODB_URI=mongodb+srv://...
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# ALLOW_LIVE_RAZORPAY_IN_DEVELOPMENT=false
# JWT_SECRET=
# API_PORT=8080
# CORS_ORIGINS=http://localhost:3000
# DEV_MOCK_OTP_ENABLED=false
